# Copy to .env.production only for a local production build.
# In Vercel or another hosting provider, set the same values in its encrypted
# environment-variable settings rather than committing this file.
NODE_ENV=production
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"
NEXTAUTH_URL="https://your-domain.example"
NEXTAUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
